#!/bin/sh
set -e

dpkg-divert --quiet --local --rename --add /usr/lib/os-release
cat > /usr/lib/os-release <<'EOF'
PRETTY_NAME="Willy Linux 2.8"
NAME="Willy Linux"
VERSION_ID="2.8"
VERSION="2.8 (basado en Debian 13 trixie)"
VERSION_CODENAME=trixie
ID=willylinux
ID_LIKE=debian
# El lobito en "Acerca del sistema" y en la cabecera de Discover.
LOGO=/usr/share/icons/hicolor/128x128/apps/willylinux.png
EOF
ln -sf ../usr/lib/os-release /etc/os-release

printf 'Willy Linux 2.8 \\n \\l\n\n' > /etc/issue
printf 'Willy Linux 2.8\n' > /etc/issue.net
: > /etc/motd

# Bloqueo de pantalla: en Plasma lo hace su propio salvapantallas, que ya pide la
# contrasena del usuario. Este envoltorio existe para que el boton y el atajo del
# menu sigan llamandose willy-lock.
cat > /usr/local/bin/willy-lock <<'EOF'
#!/bin/sh
# Willy Linux: bloquea la sesion. Contrasena del usuario live: willy
exec loginctl lock-session "$@"
EOF
chmod 755 /usr/local/bin/willy-lock

# El usuario live no tiene contrasena; sudo sin clave permite fijarsela al entrar
# en el escritorio (lo hace willy-primera-vez) para poder desbloquear la pantalla.
printf 'live ALL=(ALL:ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/willy-live
chmod 440 /etc/sudoers.d/willy-live
visudo -c -q -f /etc/sudoers.d/willy-live 2>/dev/null || rm -f /etc/sudoers.d/willy-live

# La contrasena "willy" se fija YA en la imagen. Pasar solo por willy-primera-vez
# no basta: probando la 2.8 en VirtualBox la pantalla se bloqueo sola y ni "willy"
# ni "live" abrian la sesion, porque la cuenta live seguia sin hash y el
# desbloqueo de Plasma no admite cuenta sin contrasena. auto/config fija
# username=live, asi que ese es el nombre; el uid 1000 queda de respaldo por si
# alguien cambia el usuario de la live sin tocar este hook.
USUARIO_LIVE=live
if ! getent passwd live >/dev/null 2>&1; then
	USUARIO_LIVE=$(awk -F: '$3 >= 1000 && $3 < 65000 {print $1; exit}' /etc/passwd)
fi
if [ -n "$USUARIO_LIVE" ]; then
	printf '%s:%s\n' "$USUARIO_LIVE" willy | chpasswd
	echo "0050-willylinux: contrasena fijada en la imagen para $USUARIO_LIVE" >&2
else
	echo "aviso 0050-willylinux: no hay usuario live al construir" >&2
fi

# Bajo consumo: swap en RAM (zram) y anti-congelacion (earlyoom) activos al arrancar.
mkdir -p /etc/systemd/system/multi-user.target.wants
for unit in zramswap earlyoom; do
	if [ -f "/lib/systemd/system/$unit.service" ]; then
		ln -sf "/lib/systemd/system/$unit.service" "/etc/systemd/system/multi-user.target.wants/$unit.service"
	fi
done

# Cortafuegos activo desde el primer arranque, como hacen Windows y macOS: entra al
# equipo solo lo que el propio equipo pidio. Las politicas por defecto (DROP en la
# entrada, ALLOW en la salida) ya vienen en /etc/default/ufw; lo que falta es que
# ufw.service arranque y que su config diga ENABLED=yes. El widget "Cortafuegos"
# del panel (plasma-firewall) no funciona sin esto: avisa de que no hay ninguno.
if [ -f /etc/ufw/ufw.conf ]; then
	sed -i 's|^ENABLED=.*|ENABLED=yes|' /etc/ufw/ufw.conf
	ln -sf /lib/systemd/system/ufw.service /etc/systemd/system/multi-user.target.wants/ufw.service
fi

# Firefox sin cache en disco: en la sesion live el USB es lento y se desgasta.
for d in /usr/lib/firefox-esr/defaults/pref /usr/lib/firefox-esr/defaults/preferences; do
	if [ -d "$d" ]; then
		cat > "$d/99-willylinux.js" <<'EOF'
// Willy Linux: la sesion live no deja el cache en el USB
pref("browser.cache.disk.enable", false);
EOF
		break
	fi
done
