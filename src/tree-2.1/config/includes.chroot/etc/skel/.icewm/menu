# Menu de Willy Linux: organizado en categorias cortas para no abarrotar.
# Los nombres de icono estan verificados contra la imagen compilada: el Adwaita actual
# ya no trae los colores de catalogo (solo variantes -symbolic), asi que se prefieren
# iconos de aplicacion a color y, cuando no hay, el simbolico equivalente.
menu "Oficina" libreoffice-main {
	prog "LibreOffice Inicio" libreoffice-startcenter libreoffice
	prog "Writer (texto)" libreoffice-writer libreoffice --writer
	prog "Calc (hojas de calculo)" libreoffice-calc libreoffice --calc
	prog "Impress (presentaciones)" libreoffice-impress libreoffice --impress
	prog "Editor de texto" org.xfce.mousepad mousepad
	prog "Impresoras" printer system-config-printer
	prog "Bluetooth" blueman blueman-manager
}
menu "Internet" firefox-esr {
	prog "Firefox ESR" firefox-esr firefox-esr
	prog "Navegador ligero" netsurf netsurf-gtk
	prog "Terminal" lxterminal lxterminal
}
menu "Documentos e imagenes" folder-documents {
	prog "Visor de PDF" mupdf mupdf
	prog "Visor de imagenes" feh feh
	prog "Descompactar" xarchiver xarchiver
	prog "Calculadora" galculator galculator
	prog "Editar de imagen" mtpaint mtpaint
	prog "Captura de pantalla" camera-photo-symbolic willy-captura
}
menu "Sonido y video" audio-x-generic {
	prog "Reproductor de video" mpv mpv
	prog "Grabar CD o DVD" media-optical xfburn
}
menu "Juegos" input-gaming {
	prog "Mahjong" xmahjongg /usr/games/xmahjongg
	prog "Tint (bloques)" tint /usr/games/tint
	prog "LBreakout2" lbreakouthd /usr/games/lbreakout2
	prog "Ajedrez (XBoard)" xboard /usr/games/xboard -fcp gnuchess
}
sep
menu "Sistema" computer {
	prog "Archivos" folder pcmanfm
	prog "Ajustes de Willy Linux" preferences-desktop-apps-symbolic willy-ajustes
	prog "Instalar en el disco" drive-harddisk willy-instalar
	prog "Actualizar el sistema" package-x-generic willy-actualizar
	prog "Guardar cambios en el USB" media-removable willy-persistencia
	prog "Administrador de tareas" htop lxtask
	prog "Monitor (mostrar/ocultar)" conky-logomark-violet willy-monitor-conky
	prog "Panel en la terminal" htop lxterminal -e willy-monitor
	prog "Informacion del equipo" dialog-information-symbolic lxterminal -e willy-info
	prog "Comprobar la red" network-server lxterminal -e willy-red
	prog "Apariencia (temas)" preferences-desktop-appearance-symbolic lxappearance
	prog "Resolucion de pantalla" video-display arandr
	prog "Terminal con dos paneles" mc lxterminal -e mc
	prog "htop" htop lxterminal -e htop
	sep
	prog "Bloquear pantalla" system-lock-screen-symbolic willy-lock
	prog "Reiniciar" system-reboot-symbolic sudo reboot
	prog "Apagar" system-shutdown-symbolic sudo poweroff
}
